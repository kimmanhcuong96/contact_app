DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
# Base64 for exactly 32 cryptographically random bytes. Never commit the real value.
DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
# Optional JSON key ring used only during rotation, for example {"v1":"<old-base64-key>"}.
DATA_ENCRYPTION_PREVIOUS_KEYS=
RESEND_API_KEY=
EMAIL_FROM=NexBook <noreply@example.com>
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

